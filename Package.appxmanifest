<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="MohammadHafizBinIsmail.BatchRenamerFX"
    Publisher="CN=Mohammad Hafiz bin Ismail"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Batch Renamer FX</DisplayName>
    <PublisherDisplayName>Mohammad Hafiz bin Ismail</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Windows Store compatible batch file renaming tool (Batch Renamer FX) with rule builder, file filtering, and live preview.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="BatchRenamerApp.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Batch Renamer FX"
        Description="Batch rename hundreds or thousands of files with configurable rules and preview."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\StoreLogo.png"
        Square44x44Logo="Assets\StoreLogo.png">
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
