<Window x:Class="BatchRenamerApp.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Batch Renamer FX"
        Icon="pack://application:,,,/Assets/BatchRenamerFX.ico"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Fluent Content Area (Auto-sized so no text is ever clipped) -->
        <StackPanel Grid.Row="0" Margin="24,22,24,20">

            <!-- Header: Geometric Logo with 'BR' Overlay + Application Name -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
                <Border Width="76" Height="76" CornerRadius="16" Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5" Margin="0,0,18,0">
                    <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="64" Height="64">
                            <!-- Multi-faceted Isometric Geometric Hexagonal Prism -->
                            <Polygon Points="32,6 56,19 32,32 8,19" Fill="#38BDF8" Stroke="#E0F2FE" StrokeThickness="1"/>
                            <Polygon Points="8,19 32,32 32,58 8,45" Fill="#0078D4" Stroke="#E0F2FE" StrokeThickness="1"/>
                            <Polygon Points="32,32 56,19 56,45 32,58" Fill="#005A9E" Stroke="#E0F2FE" StrokeThickness="1"/>
                            <!-- Inner golden diamond frame -->
                            <Polygon Points="32,14 48,32 32,50 16,32" Fill="#0F172A" Opacity="0.88" Stroke="#FBBF24" StrokeThickness="1.5"/>
                        </Canvas>
                        <!-- 'BR' Monogram over the Geometric Shape -->
                        <TextBlock Text="BR"
                                   FontSize="20"
                                   FontWeight="ExtraBold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,1"/>
                    </Grid>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Batch Renamer FX" FontSize="22" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    <TextBlock Text="Version 1.0.0 • .NET &amp; Windows Store Compatible" FontSize="12.5" Foreground="#5C5C5C" Margin="0,3,0,0"/>
                    <Border Background="#E5F1FB" BorderBrush="#B3D7F2" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBlock Text="Microsoft Fluent UI • MSIX Ready" FontSize="11" FontWeight="SemiBold" Foreground="#0067C0"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Description Card -->
            <Border Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#1A1A1A" LineHeight="19">
                    Batch Renamer FX is a Windows desktop utility for batch renaming hundreds or thousands of files using configurable multi-part rules, multi-criteria filtering, and real-time preview before applying changes.
                </TextBlock>
            </Border>

            <!-- Copyright & Attribution Card (Fully visible with year) -->
            <Border Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="COPYRIGHT &amp; ATTRIBUTION" FontSize="11" FontWeight="SemiBold" Foreground="#5C5C5C"/>
                    <TextBlock Text="Copyright © 2026 Mohammad Hafiz bin Ismail"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"
                               TextWrapping="Wrap"
                               Margin="0,4,0,2"/>
                    <TextBlock Text="Created and maintained by Mohammad Hafiz bin Ismail."
                               FontSize="12.5"
                               Foreground="#5C5C5C"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- License & GitHub Repository Card -->
            <Border Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="OPEN SOURCE LICENSE &amp; REPOSITORY" FontSize="11" FontWeight="SemiBold" Foreground="#5C5C5C"/>
                    <TextBlock Text="Licensed under the BSD 2-Clause License."
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"
                               TextWrapping="Wrap"
                               Margin="0,4,0,4"/>
                    <TextBlock Text="Redistribution and use in source and binary forms, with or without modification, are permitted provided that the BSD 2-Clause conditions are met."
                               FontSize="12"
                               Foreground="#5C5C5C"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="GitHub Project Page (pending registration):" FontSize="11.5" Foreground="#5C5C5C"/>
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,0">
                                <Hyperlink NavigateUri="https://github.com/mypapit/batchrenamerfx"
                                           RequestNavigate="GitHubHyperlink_RequestNavigate"
                                           Foreground="#0067C0">
                                    https://github.com/mypapit/batchrenamerfx
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="CopyGitHubUrlButton"
                                Content="Copy URL"
                                Width="86"
                                Height="28"
                                VerticalAlignment="Center"
                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                Click="CopyGitHubUrlButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Fluent Dialog Footer Bar -->
        <Border Grid.Row="1"
                Background="#F3F3F3"
                BorderBrush="#E5E5E5"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Button Content="Close"
                    Width="110"
                    Height="32"
                    HorizontalAlignment="Right"
                    Style="{StaticResource FluentPrimaryButtonStyle}"
                    IsDefault="True"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </Border>
    </Grid>
</Window>
