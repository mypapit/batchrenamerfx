<Window x:Class="BatchRenamerApp.Views.FluentDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Renamer FX"
        Icon="pack://application:,,,/Assets/BatchRenamerFX.ico"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Content Surface (Fluent ContentDialog Content Area) -->
        <StackPanel Grid.Row="0" Margin="24,22,24,20">
            <TextBlock x:Name="DialogTitleTextBlock"
                       Text="Confirm Action"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#1A1A1A"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="DialogMessageTextBlock"
                       Text="Are you sure you want to proceed?"
                       FontSize="13.5"
                       Foreground="#333333"
                       LineHeight="20"
                       TextWrapping="Wrap"/>

            <Border x:Name="DetailsBorder"
                    Visibility="Collapsed"
                    Background="#F9F9F9"
                    BorderBrush="#E5E5E5"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,12,0,0">
                <TextBlock x:Name="DialogDetailsTextBlock"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#1A1A1A"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Bottom Command Bar (Fluent ContentDialog Footer Area: #F3F3F3 with #E5E5E5 top border) -->
        <Border Grid.Row="1"
                Background="#F3F3F3"
                BorderBrush="#E5E5E5"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PrimaryActionButton"
                        Grid.Column="1"
                        Content="Confirm"
                        MinWidth="120"
                        Height="32"
                        Margin="0,0,8,0"
                        Style="{StaticResource FluentPrimaryButtonStyle}"
                        IsDefault="True"
                        Click="PrimaryActionButton_Click"/>

                <Button x:Name="SecondaryActionButton"
                        Grid.Column="2"
                        Content="Cancel"
                        MinWidth="120"
                        Height="32"
                        Style="{StaticResource FluentSecondaryButtonStyle}"
                        IsCancel="True"
                        Click="SecondaryActionButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

