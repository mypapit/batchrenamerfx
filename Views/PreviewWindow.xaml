<Window x:Class="BatchRenamerApp.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview Changes — Batch Renamer FX"
        Icon="pack://application:,,,/Assets/BatchRenamerFX.ico"
        Width="860" Height="540"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#F3F3F3">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Summary Card -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="18,16,18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Preview of Batch Rename Changes" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    <TextBlock x:Name="SummaryTextBlock" Text="Review the original filenames and their new filenames below before applying changes." FontSize="12.5" Foreground="#5C5C5C" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#E5F1FB" BorderBrush="#B3D7F2" BorderThickness="1" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock x:Name="OperationModeBadge" Text="Mode: Rename in Same Folder" FontSize="12" FontWeight="SemiBold" Foreground="#0067C0"/>
                </Border>
            </Grid>
        </Border>

        <!-- Preview Table -->
        <DataGrid x:Name="PreviewDataGrid"
                  Grid.Row="1"
                  Margin="18,0,18,14"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#ECECEC"
                  RowBackground="White"
                  AlternatingRowBackground="#F9F9F9"
                  BorderBrush="#E5E5E5"
                  BorderThickness="1"
                  FontSize="12.5">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                <DataGridTextColumn Header="Original Filename" Binding="{Binding OriginalFileName}" IsReadOnly="True" Width="190"/>
                <DataGridTextColumn Header="New Filename (Preview)" Binding="{Binding PreviewNewFileName}" IsReadOnly="True" Width="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#0067C0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ext" Binding="{Binding Extension}" IsReadOnly="True" Width="65"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Destination Path" Binding="{Binding PreviewDestinationPath}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Fluent Footer Command Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Rename Files"
                        Width="140"
                        Height="32"
                        Margin="0,0,8,0"
                        Style="{StaticResource FluentPrimaryButtonStyle}"
                        IsDefault="True"
                        Click="ApplyRenameButton_Click"/>
                <Button Content="Close"
                        Width="110"
                        Height="32"
                        Style="{StaticResource FluentSecondaryButtonStyle}"
                        IsCancel="True"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
